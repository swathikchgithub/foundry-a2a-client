# ---------- Local A2A agent ----------
# Port the local A2A server listens on.
A2A_PORT=8000
# Public HTTPS URL that Foundry uses to reach this server (your tunnel URL,
# e.g. https://abc123-8000.usw2.devtunnels.ms). Used in the agent card.
# Leave as localhost while you only test locally.
A2A_PUBLIC_URL=http://localhost:8000
# Shared secret Foundry must send in the x-api-key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
A2A_API_KEY=change-me

# ---------- Foundry client ----------
# Foundry portal -> your project -> Overview -> "Project endpoint"
PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# A model deployment in that project
MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
# Name of the A2A connection you create in the Foundry portal (Step 5 in README)
A2A_CONNECTION_NAME=ticket-triage-a2a
# Name of the Foundry agent this project creates
FOUNDRY_AGENT_NAME=helpdesk-orchestrator
